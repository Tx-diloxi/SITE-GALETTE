<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirige toutes les requêtes non-physiques vers index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Sécurité : protection contre le reniflage MIME
    Header always set X-Content-Type-Options "nosniff"
    # Sécurité : empêche l'affichage dans une iframe (sauf même origine)
    Header always set X-Frame-Options "SAMEORIGIN"
    # Sécurité : contrôle les informations de référent transmises
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Sécurité : protection contre le détournement de clic et les scripts non autorisés
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>
